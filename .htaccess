RewriteEngine On
RewriteBase /

# Protect sensitive files
<FilesMatch "\.(db|db-wal|db-shm|log)$">
    Require all denied
</FilesMatch>

# Route all requests through index.php (except existing files/dirs)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?page=$1 [QSA,L]
